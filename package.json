{
  "name": "skipthegames4ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:server && concurrently \"npm run dev\" \"node dist/server/index.js\"",
    "build": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start:prod": "node dist/server/index.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "postinstall": "npm run build && npm run build:server",
    "render-build": "npm run build && npm run build:server && cp -r dist dist-backup && mkdir -p dist/server && cp -r dist-backup/* dist/ && cp -r dist/server/* dist/server/ && rm -rf dist-backup"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@types/jsonwebtoken": "^9.0.9",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.14.2",
    "openai": "^4.28.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "vite": "^5.1.4",
    "typescript": "^5.2.2",
    "@vitejs/plugin-react": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2"
  }
}
